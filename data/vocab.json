{"version":1,"settings":{"newPerDay":50,"reviewLimit":50,"fetchLongman":true,"againMinutes":10,"efMax":2.8,"hardFactor":1.2,"easyFactor":1.3,"autoMasterDays":0},"words":[{"id":"wmvs5wywmw0f7l","term":"situate","key":"situate","userDef":"义：使位于；使处于某种背景或环境中。常用被动 be situated in/on/at。例：The town is situated at the junction of three provinces.（小镇位于三省交界处）也可说 situate a story in the 1930s，把故事设定在 20 世纪 30 年代。","createdAt":1793194851766,"srs":{"ef":2.6,"interval":4,"reps":1,"lapses":0,"due":1793548800000,"lastGrade":5,"lastReview":1793240443995,"history":[{"t":1793240443995,"grade":5,"ivl":4,"ef":2.6}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793240443995},{"id":"wmvs5wywm4s4t8","term":"junction","key":"junction","userDef":"义：交汇处；交叉点；连接处。搭配：at the junction of A and B。例：at the junction of three provinces 位于三省交界处。也可指道路、铁路的交汇点。","createdAt":1793194851767,"srs":{"ef":2.5,"interval":2,"reps":1,"lapses":0,"due":1793376000000,"lastGrade":4,"lastReview":1793240571753,"history":[{"t":1793240571753,"grade":4,"ivl":2,"ef":2.5}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793240571753},{"id":"wmvs5wywm37nj7","term":"converge","key":"converge","userDef":"义：汇聚；交会；趋于一致。搭配：converge at/on。例：The three borders converge here.（三条边界在此交会）抽象用法：Their opinions converged. 意见趋于一致。","createdAt":1793194851768,"srs":{"ef":2.36,"interval":1,"reps":1,"lapses":0,"due":1793289600000,"lastGrade":3,"lastReview":1793240929901,"history":[{"t":1793240929901,"grade":3,"ivl":1,"ef":2.36}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793240929901},{"id":"wmvs5wywm5sqw2","term":"glisten","key":"glisten","userDef":"义：闪亮；泛着微光，常因水分、湿润表面或光线反射而发亮。搭配：glistening water / a glistening river。常有湿润、清亮的视觉效果。","createdAt":1793194851769,"srs":{"ef":2.36,"interval":1,"reps":1,"lapses":0,"due":1793289600000,"lastGrade":3,"lastReview":1793241035331,"history":[{"t":1793241035331,"grade":3,"ivl":1,"ef":2.36}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793241035331},{"id":"wmvs5wywmc0rve","term":"glitter","key":"glitter","userDef":"义：闪闪发光；闪耀，通常突出许多明亮、醒目的光点。例：The stars glittered in the sky.（星星在天空中闪烁）也可指浮华、表面光鲜：the glitter of fame。","createdAt":1793194851770,"srs":{"ef":2.36,"interval":1,"reps":1,"lapses":0,"due":1793289600000,"lastGrade":3,"lastReview":1793241334236,"history":[{"t":1793241334236,"grade":3,"ivl":1,"ef":2.36}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793241334236},{"id":"wmvs5wywm1emof","term":"glow","key":"glow","userDef":"义：发出柔和、持续的光；泛红；容光焕发。例：glow in the dark；the sky glowed red。辨：相比 glitter，通常不是许多尖锐的闪光点，而是较柔和、连续的光。","createdAt":1793194851771,"srs":{"ef":2.36,"interval":1,"reps":1,"lapses":0,"due":1793289600000,"lastGrade":3,"lastReview":1793241608478,"history":[{"t":1793241608478,"grade":3,"ivl":1,"ef":2.36}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793241608478},{"id":"wmvs5wywmmjq4a","term":"idyllic","key":"idyllic","userDef":"义：田园诗般的；宁静美好的；理想化的。搭配：an idyllic village / an idyllic setting。辨：比 peaceful 更有理想化、如诗如画的意味。","createdAt":1793194851772,"srs":{"ef":2.36,"interval":1,"reps":1,"lapses":0,"due":1793289600000,"lastGrade":3,"lastReview":1793241836544,"history":[{"t":1793241836544,"grade":3,"ivl":1,"ef":2.36}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793241836544},{"id":"wmvs5wywm99dgc","term":"a border town","key":"a border town","userDef":"义：边境小镇；边界地区的城镇。搭配：a remote border town 偏远的边陲小镇。注意拼写是 border，不是 boder。","createdAt":1793194851773,"srs":{"ef":2.36,"interval":1,"reps":1,"lapses":0,"due":1793289600000,"lastGrade":3,"lastReview":1793242294342,"history":[{"t":1793242294342,"grade":3,"ivl":1,"ef":2.36}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793242294342},{"id":"wmvs5wywmd34cp","term":"wind its way through","key":"wind its way through","userDef":"义：蜿蜒穿过；曲折延伸穿过。例：A stream winds its way through the town.（一条小溪蜿蜒穿过小镇）辨：wind 在这里读 /waɪnd/，不是“风”的 /wɪnd/。","createdAt":1793194851774,"srs":{"ef":2.5,"interval":2,"reps":1,"lapses":0,"due":1793376000000,"lastGrade":4,"lastReview":1793242534662,"history":[{"t":1793242534662,"grade":4,"ivl":2,"ef":2.5}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793242534662},{"id":"wmvs5wywmt7vxd","term":"wind its way along","key":"wind its way along","userDef":"义：沿着……蜿蜒延伸。例：The path winds its way along the river.（小路沿河蜿蜒延伸）辨：through 强调穿过某区域；along 强调沿着某条线或某个边缘延伸。","createdAt":1793194851775,"srs":{"ef":2.5,"interval":2,"reps":1,"lapses":0,"due":1793376000000,"lastGrade":4,"lastReview":1793242552645,"history":[{"t":1793242552645,"grade":4,"ivl":2,"ef":2.5}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793242552645},{"id":"wmvs5wywmuedz8","term":"ferry","key":"ferry","userDef":"义：渡船；渡运服务；渡运。可作名词或动词：take the ferry 乘渡船；ferry passengers across the river 把乘客渡送到河对岸。","createdAt":1793194851776,"srs":{"ef":2.6,"interval":4,"reps":1,"lapses":0,"due":1793548800000,"lastGrade":5,"lastReview":1793242673883,"history":[{"t":1793242673883,"grade":5,"ivl":4,"ef":2.6}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793242673883},{"id":"wmvs5wywm33n47","term":"ferryboat","key":"ferryboat","userDef":"义：渡船，尤指用于运送乘客或车辆横渡水域的船。辨：与 ferry 意义重叠，但 ferry 更灵活，也能指整个渡运服务；普通行文中往往不必特意用 ferryboat。","createdAt":1793194851777,"srs":{"ef":2.6,"interval":4,"reps":1,"lapses":0,"due":1793548800000,"lastGrade":5,"lastReview":1793242684119,"history":[{"t":1793242684119,"grade":5,"ivl":4,"ef":2.6}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793242684119},{"id":"wmvs5wywmkhz8x","term":"ferryman","key":"ferryman","userDef":"义：摆渡人；渡船船夫。传统语境中常指负责操船、把人渡过河的人。","createdAt":1793194851778,"srs":{"ef":2.6,"interval":4,"reps":1,"lapses":0,"due":1793548800000,"lastGrade":5,"lastReview":1793242695894,"history":[{"t":1793242695894,"grade":5,"ivl":4,"ef":2.6}]},"mastered":false,"deleted":false,"status":"learning","updatedAt":1793242695894},{"id":"wmvs5wywmbrq57","term":"boatman","key":"boatman","userDef":"义：船夫；操船的人。辨：范围比 ferryman 广，不一定专门从事摆渡。","createdAt":1793194851779,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851779},{"id":"wmvs5wywmv8bv3","term":"tend","key":"tend","userDef":"义：照料；看管；料理；照管。搭配：tend a garden / tend livestock / tend the ferry。辨：tend the ferry 可以表示看管渡船，但不一定明确表示实际操船。","createdAt":1793194851780,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851780},{"id":"wmvs5wywm4oulj","term":"ply","key":"ply","userDef":"义：定期往返；在固定航线上运营；从事某种活动。例：Ferries ply between the two banks.（渡船往返于两岸）强调规律性、持续性的运输活动。","createdAt":1793194851781,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851781},{"id":"wmvs5wywm9vejr","term":"shuttle","key":"shuttle","userDef":"义：在两地之间往返运送；穿梭。例：The boat shuttles passengers between the two banks.（小船往返于两岸运送乘客）强调反复接送。","createdAt":1793194851782,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851782},{"id":"wmvs5wywma4i9z","term":"glide","key":"glide","userDef":"义：平稳、轻柔地滑行。例：The ferry glided across the river.（渡船平稳地滑过河面）突出运动的流畅、轻盈，而不是固定航线。","createdAt":1793194851783,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851783},{"id":"wmvs5wywmriee3","term":"undercurrent","key":"undercurrent","userDef":"义：暗流；潜流；潜在的情绪、趋势或影响。搭配：an undercurrent beneath the surface 表面之下的暗流。比喻用法：an undercurrent of tension 潜藏的紧张气氛。","createdAt":1793194851784,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851784},{"id":"wmvs5wywm1sbtm","term":"stealthy","key":"stealthy","userDef":"义：秘密的；悄无声息的；不易察觉的。搭配：a stealthy movement / a stealthy approach。强调行动隐蔽，常带有谨慎、秘密甚至鬼祟的意味。","createdAt":1793194851785,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851785},{"id":"wmvs5wywm9g85e","term":"stir","key":"stir","userDef":"义：搅动；微微移动；激起情绪或反应。例：The wind stirred the leaves.（风吹动了树叶）stir emotions 激起情绪。也可指某种力量开始活动：Something was stirring beneath the surface。","createdAt":1793194851786,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851786},{"id":"wmvs5wywm85n5k","term":"stir up","key":"stir up","userDef":"义：搅起；激起；挑起；煽动。搭配：stir up trouble / anger / controversy 惹起麻烦、激起愤怒、引发争议。辨：比单独的 stir 更常强调引发某种反应或使局势变得不平静。","createdAt":1793194851787,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851787},{"id":"wmvs5wywm0xim1","term":"move","key":"move","userDef":"此义 = progress。义：发展；推进；演变；运行。例：Events are moving quickly.（事态进展很快）History moves on. 历史继续向前发展。辨：Fate moves beneath the surface 是文学性的拟人表达，不是 move = progress 在所有语境中都能互换。","createdAt":1793194851788,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851788},{"id":"wmvs5wywml6fnb","term":"woodland sprite","key":"woodland sprite","userDef":"义：林间精灵；森林中的小精灵。sprite 指精灵、仙灵，常用于奇幻或文学语境。例：a girl as free-spirited as a woodland sprite（一个像林间精灵般自由灵动的女孩）","createdAt":1793194851789,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851789},{"id":"wmvs5wywmq6vwd","term":"forthright","key":"forthright","userDef":"义：直率的；坦诚的；直截了当的。搭配：a forthright person / a forthright manner。强调说话、表达态度时坦率直接，通常是正面评价。","createdAt":1793194851790,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851790},{"id":"wmvs5wywmcl2bd","term":"hearty","key":"hearty","userDef":"义：热情友好的；爽朗的；衷心的；丰盛的。搭配：a hearty welcome / hearty laughter / a hearty meal。辨：形容人时可指热情、爽朗，但不等于“豪爽”的全部含义。","createdAt":1793194851791,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851791},{"id":"wmvs5wywmet9mn","term":"vivacity","key":"vivacity","userDef":"义：活泼；生气勃勃；充满活力。搭配：her vivacity and charm（她的活泼与魅力）强调生命力、活力和生动感。","createdAt":1793194851792,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851792},{"id":"wmvs5wywmne5ur","term":"alacrity","key":"alacrity","userDef":"义：欣然；敏捷积极；乐意而迅速的反应。搭配：respond with alacrity 欣然迅速地回应。辨：强调做事时的积极、爽快和乐意，不直接等于“灵动”。","createdAt":1793194851793,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851793},{"id":"wmvs5wywml6c0m","term":"duel","key":"duel","userDef":"义：决斗；对决；竞争。搭配：a duel between the two brothers（两兄弟之间的对决）传统上可指武力决斗，也可比喻激烈竞争。","createdAt":1793194851794,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851794},{"id":"wmvs5wywme0h9j","term":"duet","key":"duet","userDef":"义：二重奏；二重唱；两人合作表演。搭配：sing a duet 唱二重唱。辨：与 duel 只差一个字母，但 duel 强调对抗，duet 强调两人共同演奏或演唱。","createdAt":1793194851795,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851795},{"id":"wmvs5wywm9lo0y","term":"smart from","key":"smart from","userDef":"义：因……而感到痛苦、愤愤不平。搭配：smart from rejection 因遭到拒绝而痛苦。更常见的搭配还包括 smart under criticism（因受到批评而难受）、smart with humiliation（因受辱而痛苦）","createdAt":1793194851796,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851796},{"id":"wmvs5wywma0kfm","term":"courtship","key":"courtship","userDef":"义：求爱；追求某人的过程；求婚前的恋爱交往。搭配：the courtship of a young woman（追求一位年轻女性）辨：语体比 dating 正式、传统，常见于文学或历史叙述。","createdAt":1793194851797,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851797},{"id":"wmvs5wywmx8dqv","term":"pale into insignificance","key":"pale into insignificance","userDef":"义：相形见绌；显得微不足道。例：All other concerns paled into insignificance beside this loss.（与这次损失相比，其他事情都显得微不足道）辨：这里的 pale 是“显得黯淡”，不是身体变苍白。","createdAt":1793194851798,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851798},{"id":"wmvs5wywmoner3","term":"despondent","key":"despondent","userDef":"义：沮丧的；失去希望的；意气消沉的。搭配：feel / become despondent。辨：比一般的 sad 更强调失去信心、看不到希望。","createdAt":1793194851799,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851799},{"id":"wmvs5wywm6ek4p","term":"lose one's heart to someone","key":"lose one's heart to someone","userDef":"义：爱上某人；倾心于某人。例：Both brothers lose their hearts to Cuicui.（两兄弟都爱上了翠翠）辨：比 fall in love with 更有文学色彩。","createdAt":1793194851800,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851800},{"id":"wmvs5wywm9walx","term":"ringing","key":"ringing","userDef":"义：清脆响亮的；嘹亮的；回响的。搭配：a ringing voice 响亮清晰的声音。也可表示斩钉截铁的：a ringing endorsement（明确有力的支持）","createdAt":1793194851801,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851801},{"id":"wmvs5wywmkkppc","term":"resonate","key":"resonate","userDef":"义：回响；产生共鸣；引起共鸣。例：His words resonated with the audience.（他的话引起了听众的共鸣）也可指声音在空间中回荡。","createdAt":1793194851802,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851802},{"id":"wmvs5wywmguixk","term":"resonant","key":"resonant","userDef":"义：洪亮的；共鸣的；引起共鸣的。搭配：a deep, resonant voice 低沉浑厚的声音。辨：它是形容词；resonate 是动词。","createdAt":1793194851803,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851803},{"id":"wmvs5wywmvnofi","term":"drown","key":"drown","userDef":"义：溺水；淹死；淹没、压过声音。搭配：drown in the river 在河中溺亡；drown out the noise 压过噪声。注意：drown 本身不表示自杀。","createdAt":1793194851804,"srs":{"ef":2.5,"interval":0,"reps":0,"lapses":0,"due":1793194851766,"lastGrade":null,"lastReview":null,"history":[]},"mastered":false,"deleted":false,"status":"new","updatedAt":1793194851804},{"id":"wmvs5wywmdi4oz","term":"elect","key":"elect","userDef":"义：选择；决定（较正式）。搭配：elect to leav